node_modules/
.DS_Store

*.log
.codegraph/

# 本地 agent / 工具配置：属于维护者的机器，不随包分发。
# .claude/settings.json 是权限白名单（含 git push），跟着公开仓库分发等于
# 让每个 clone 的人自动继承免确认权限。
.claude/
.rtk/
.agents/

# 维护者本机装的第三方 skill 会往 skills/ 里软链（曾提交进来 8 条指向
# .agents/ 的死链）。本包只分发自己的两个 skill，白名单在这里定死。
skills/*
!skills/sdd-init/
!skills/sdd-interview/
