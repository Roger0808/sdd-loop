{
  "name": "sdd-loop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roger0808/sdd-loop.git"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sdd-loop": "./scripts/sdd-loop.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills/sdd-init",
      "./skills/sdd-interview"
    ]
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 --test-force-exit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "description": "SDD Loop 的两件仪器：状态对账 + 口径字典。skill + CLI 为主体，pi 扩展可选；pi 与 Claude Code 均可用。"
}
